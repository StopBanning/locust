// Locust's relay on Cloudflare Workers, deployed from this folder with `npx wrangler deploy`. Anyone running their own
// copy changes the route below to a domain of theirs and starts Locust with LOCUST_RELAY set to its address.
{
  "name": "locust-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "routes": [{ "pattern": "app.locust.lol", "custom_domain": true }],
  "durable_objects": {
    // ACCOUNTS (0.838): one per GitHub account, the computers a browser signed in as it may open (src/account.ts).
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "ACCOUNTS", "class_name": "Account" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Account"] }],
  // The home-screen app's icons, bundled as bytes.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  // The public half of the key alerts are signed with; the private half is a secret: `wrangler secret put VAPID_PRIVATE_JWK`.
  "vars": { "VAPID_PUBLIC_KEY": "BKnPmizkshlRYQ7W_B_9q2XGAGfYvPZtJEy2BDAJBjprlN3w94yDYPtjJ7bTOHtCvSkgJ7Qq1KVSvghyleQpPUk" },
  // Workers Logs off: the relay writes no log of its own of who connected or when.
  "observability": { "enabled": false }
}
