{
  "name": "@teammate/desktop",
  "version": "0.818.0",
  "private": true,
  "description": "Run AI coding agents as a team you can watch, on runtimes and models you choose.",
  "author": "Automated Workflow",
  "homepage": "https://locust.lol",
  "desktopName": "locust.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "pnpm --filter @teammate/runtime-adapters build && pnpm --filter @teammate/mission-store build",
    "dev": "electron-vite dev",
    "prebuild": "pnpm --filter @teammate/runtime-adapters build && pnpm --filter @teammate/mission-store build",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --config electron-builder.yml && node scripts/prune-releases.mjs",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "prune:releases": "node scripts/prune-releases.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "3.3.1",
    "voice-glow": "0.3.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@teammate/cli": "workspace:*",
    "@teammate/mission-store": "workspace:*",
    "@teammate/runtime-adapters": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "border-beam": "1.3.0",
    "bot-avatars": "0.2.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "~0.16.47",
    "liquid-gooey": "0.2.1",
    "mermaid": "11.17.2",
    "metal-fx": "^2.0.10",
    "npm": "^12.0.2",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "6.3.289",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "4.4.3",
    "thinking-orbs": "^0.3.1",
    "vite": "7.3.6"
  }
}
